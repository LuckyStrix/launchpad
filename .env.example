# Copy to .env (gitignored) and fill in. Only TS_AUTHKEY is required to start;
# each integration lights up once its variables are set.

# --- Tailscale sidecar ---
# Admin console > Settings > Keys > Generate auth key (reusable off is fine; the
# node state is kept in a volume). Optionally pre-approve it with a tag.
TS_AUTHKEY=
TS_HOSTNAME=launchpad
# e.g. --advertise-tags=tag:launchpad
TS_EXTRA_ARGS=
# https://<TS_HOSTNAME>.<your-tailnet>.ts.net — needed for Google sign-in.
PUBLIC_URL=

# --- Hermes (the assistant's brain) ---
# Hermes's OpenAI-compatible API server, reached over the launchpad-hermes network.
HERMES_URL=http://hermes:8642/v1
# Must equal API_SERVER_KEY in Hermes's ~/.hermes/.env
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Token Hermes must send to Launchpad's MCP server (generate: openssl rand -hex 32)
LAUNCHPAD_MCP_TOKEN=
# Seconds a write action waits for your approval before it is treated as denied
APPROVAL_TIMEOUT=300

# --- Home Assistant ---
# URL as seen from the container (MagicDNS names work), and a long-lived access token
# (HA profile > Security > Long-lived access tokens).
HASS_URL=http://homeassistant:8123
HASS_TOKEN=
# Optional: URL your browser should open for HA, if different from HASS_URL
HASS_PUBLIC_URL=

# --- GitHub ---
# Fine-grained token: repository access to the repos you want, with read access to
# Metadata, Actions, Pull requests, Issues; write to Actions and Issues for the
# workflow button and create-issue tool.
GITHUB_TOKEN=

# --- Google Calendar and Tasks ---
# Google Cloud console: OAuth client (Web application) with redirect URI
# <PUBLIC_URL>/api/google/callback; enable the Calendar and Tasks APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
